   return 0;
 }
 
+/**
+ * Andromax: list the immediate children of a folder with a few bulk
+ * GetObjectPropList requests (one per property) instead of one GetObjectInfo
+ * per object, which turns folders with thousands of photos from minutes into
+ * seconds. Single properties are asked for because Android rejects the
+ * "all properties" form for some folders (0xA801).
+ * @param storage storage to keep (0 = any).
+ * @param parent folder id, or LIBMTP_FILES_AND_FOLDERS_ROOT.
+ * @param out receives the list (may be NULL when the folder is empty).
+ * @return 0 on success, -1 when the device can't do this (use
+ *         LIBMTP_Get_Files_And_Folders() instead).
+ */
+struct andromax_child { uint32_t handle; LIBMTP_file_t *file; };
+
+static int andromax_child_cmp(const void *a, const void *b)
+{
+  uint32_t x = ((const struct andromax_child *) a)->handle;
+  uint32_t y = ((const struct andromax_child *) b)->handle;
+  return x < y ? -1 : x > y;
+}
+
+int LIBMTP_Get_Children_Fast(LIBMTP_mtpdevice_t *device,
+			     uint32_t const storage,
+			     uint32_t const parent,
+			     LIBMTP_file_t **out)
+{
+  static const uint16_t codes[] = {
+    PTP_OPC_ObjectFileName, PTP_OPC_ObjectFormat, PTP_OPC_ObjectSize,
+    PTP_OPC_DateModified, PTP_OPC_StorageID
+  };
+  PTPParams *params = (PTPParams *) device->params;
+  PTP_USB *ptp_usb = (PTP_USB*) device->usbinfo;
+  uint32_t handle = parent == LIBMTP_FILES_AND_FOLDERS_ROOT ? 0 : parent;
+  struct andromax_child *children = NULL;
+  int count = 0, oldtimeout, c, j, failed = 0;
+  LIBMTP_file_t *kept = NULL, *last = NULL;
+
+  *out = NULL;
+  if (!ptp_operation_issupported(params, PTP_OC_MTP_GetObjPropList))
+    return -1;
+
+  get_usb_device_timeout(ptp_usb, &oldtimeout);
+  set_usb_device_timeout(ptp_usb, 60000);
+  for (c = 0; c < (int) (sizeof(codes) / sizeof(codes[0])) && !failed; c++) {
+    MTPObjectProp *props = NULL;
+    int nrofprops = 0;
+    uint16_t ret = ptp_mtp_getobjectproplist_generic(params, handle, 0, codes[c], 0, 1,
+                                                     &props, &nrofprops);
+    if (ret != PTP_RC_OK) {
+      add_ptp_error_to_errorstack(device, ret, "LIBMTP_Get_Children_Fast(): "
+				  "could not get proplist of children.");
+      failed = 1;
+      break;
+    }
+    if (c == 0) {
+      /* The file names define the set of children. */
+      children = calloc(nrofprops ? nrofprops : 1, sizeof(*children));
+      for (j = 0; j < nrofprops && children; j++) {
+        LIBMTP_file_t *file = LIBMTP_new_file_t();
+        if (file == NULL) { failed = 1; break; }
+        file->item_id = props[j].ObjectHandle;
+        file->parent_id = handle;
+        file->storage_id = storage;
+        file->filename = strdup(props[j].Value.str ? props[j].Value.str : "<null>");
+        children[count].handle = file->item_id;
+        children[count].file = file;
+        count++;
+      }
+      if (children == NULL) failed = 1;
+      qsort(children, count, sizeof(*children), andromax_child_cmp);
+    } else {
+      for (j = 0; j < nrofprops; j++) {
+        struct andromax_child key = { props[j].ObjectHandle, NULL };
+        struct andromax_child *hit = bsearch(&key, children, count, sizeof(*children), andromax_child_cmp);
+        LIBMTP_file_t *file = hit ? hit->file : NULL;
+        if (file == NULL) continue;
+        switch (codes[c]) {
+        case PTP_OPC_ObjectFormat:
+          file->filetype = map_ptp_type_to_libmtp_type(props[j].Value.u16);
+          break;
+        case PTP_OPC_ObjectSize:
+          file->filesize = props[j].DataType == PTP_DTC_UINT64 ? props[j].Value.u64 : props[j].Value.u32;
+          break;
+        case PTP_OPC_StorageID:
+          file->storage_id = props[j].Value.u32;
+          break;
+        case PTP_OPC_DateModified:
+          if (props[j].Value.str != NULL) {
+            struct tm tm;
+            memset(&tm, 0, sizeof(tm));
+            /* MTP dates look like "20231004T153012", in the phone's local time */
+            if (sscanf(props[j].Value.str, "%4d%2d%2dT%2d%2d%2d", &tm.tm_year, &tm.tm_mon,
+                       &tm.tm_mday, &tm.tm_hour, &tm.tm_min, &tm.tm_sec) == 6) {
+              tm.tm_year -= 1900;
+              tm.tm_mon -= 1;
+              tm.tm_isdst = -1;
+              file->modificationdate = mktime(&tm);
+            }
+          }
+          break;
+        }
+      }
+    }
+    for (j = 0; j < nrofprops; j++)
+      if (props[j].DataType == PTP_DTC_STR)
+        free(props[j].Value.str);
+    free(props);
+  }
+  set_usb_device_timeout(ptp_usb, oldtimeout);
+
+  /* Keep the device's order, minus the folder itself and other storages. */
+  for (j = 0; j < count; j++) {
+    LIBMTP_file_t *file = children[j].file;
+    if (failed || file->item_id == handle || (storage != 0 && file->storage_id != storage)) {
+      LIBMTP_destroy_file_t(file);
+      continue;
+    }
+    if (last) last->next = file; else kept = file;
+    last = file;
+  }
+  free(children);
+  if (failed)
+    return -1;
+  *out = kept;
+  return 0;
+}
+
